<Window x:Class="SoftNodesOpen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SoftNodesOpen"
        xmlns:p="clr-namespace:FactoryNodes.SoftNodes.Open.Presentation;assembly=FactoryNodes.SoftNodes.Open.Presentation"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="SoftNodes" Width="1250" Height="800" MinWidth="860" MinHeight="520" Icon="Assets/softnodes.ico" Background="{StaticResource PaperBrush}">

    <!-- La ventana del SoftNodes abierto (DataContext = SoftNodesOpenViewModel): a la izquierda las instancias; a la derecha la elegida (botones,
         configuración, variables y registro); abajo, la línea de estado. Solo pinta y reenvía. -->

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/softnodes.ico" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="SoftNodes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding NewInstanceCommand}"
                            ToolTip="{l:T 'Nueva instancia…: un PLC simulado con el programa que guarda FactoryNodes («Exportar a PLC» ▸ SoftNodes, .softnodes)'}">
                        <Image Source="{Binding Source={x:Static p:OpenIcons.NewInstance}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RemoveInstanceCommand}" ToolTip="{l:T 'Borrar la instancia elegida y su carpeta (apagada)'}">
                        <Image Source="{Binding Source={x:Static p:OpenIcons.RemoveInstance}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="LanguageButton" Style="{StaticResource IconButton}" Margin="0" Click="OnLanguageClick"
                        ToolTip="{l:T 'Idioma del programa (se vuelve a abrir)'}">
                    <Image Source="{Binding Source={x:Static p:OpenIcons.Language}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Languages}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                    <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="{l:T 'El PLC simulado de FactoryNodes: ejecuta el programa y lo sirve por OPC UA, EtherNet/IP y Modbus TCP, como un PLC real.'}"
                           Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource GrayBrush}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ======================================== Las instancias ======================================== -->
        <Border DockPanel.Dock="Left" Width="250" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" BorderThickness="0" Margin="6" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource GrayBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TealBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding State}" Foreground="{StaticResource GrayBrush}" FontSize="11" Margin="17,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ======================================== La instancia elegida ======================================== -->
        <Grid Margin="12" DataContext="{Binding Selected}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabecera: nombre, estado, direcciones y botones -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource MistBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PowerCommand}" ToolTip="{Binding PowerText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Image Source="{Binding Source={x:Static p:OpenIcons.PowerOn}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Image Source="{Binding Source={x:Static p:OpenIcons.PowerOff}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding RunCommand}" ToolTip="{l:T 'RUN: el PLC ejecuta el programa ciclo a ciclo'}">
                            <Image Source="{Binding Source={x:Static p:OpenIcons.Run}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding StopCommand}" ToolTip="{l:T 'STOP: el PLC deja de ejecutar; la memoria se conserva'}">
                            <Image Source="{Binding Source={x:Static p:OpenIcons.Stop}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ReloadCommand}" ToolTip="{l:T 'Recargar el programa de la carpeta (el que acaba de transferir FactoryNodes), conservando lo que sigue igual'}">
                            <Image Source="{Binding Source={x:Static p:OpenIcons.Reload}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ColdStartCommand}" ToolTip="{l:T 'Arranque en frío: como recargar, pero todas las variables vuelven a su valor inicial'}">
                            <Image Source="{Binding Source={x:Static p:OpenIcons.ColdStart}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding LoadProgramCommand}" Margin="0" ToolTip="{l:T 'Cargar otro programa (.softnodes) en esta instancia'}">
                            <Image Source="{Binding Source={x:Static p:OpenIcons.Load}, Converter={StaticResource SvgImage}}" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding State}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource GrayBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding ProgramText}" Foreground="{StaticResource GrayBrush}" Margin="0,2,0,0" />
                        <TextBox Text="{Binding Endpoints, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" Padding="0" Margin="0,2,0,0"
                                 ToolTip="{l:T 'Las direcciones a las que se conectan FactoryNodes, una pantalla u otro PLC (desde otro equipo, con la IP de este)'}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Configuración -->
            <WrapPanel Grid.Row="1" Margin="0,10,0,6" IsEnabled="{Binding CanEditSettings}">
                <TextBlock Text="{l:T 'Perfil'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T 'Qué PLC simula: «TIA» (un S7-1500) o «Sysmac» (un NX/NJ). Elige cómo se nombran las variables por OPC UA. Solo con la instancia apagada.'}" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Width="90" Margin="0,0,14,4" />
                <TextBlock Text="{l:T 'Puerto OPC UA'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,14,4" />
                <TextBlock Text="{l:T 'Puerto EtherNet/IP'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T '44818 es el de serie; cada instancia el suyo; 0 = sin servidor EtherNet/IP'}" />
                <TextBox Text="{Binding EipPort, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,14,4" />
                <TextBlock Text="{l:T 'Puerto Modbus TCP'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T '502 es el de serie; 0 = sin servidor Modbus. Solo arranca si el programa trae su tabla Modbus.'}" />
                <TextBox Text="{Binding ModbusPort, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,14,4" />
                <TextBlock Text="{l:T 'Ciclo (ms)'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T 'Lo que avanza el reloj del PLC en cada ciclo'}" />
                <TextBox Text="{Binding CycleMs, UpdateSourceTrigger=LostFocus}" Width="50" Margin="0,0,14,4" />
                <TextBlock Text="{l:T 'Velocidad'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T '1 = tiempo real; 10 = el reloj del PLC va diez veces más deprisa'}" />
                <TextBox Text="{Binding TimeScale, UpdateSourceTrigger=LostFocus}" Width="50" Margin="0,0,14,4" />
                <CheckBox Content="{l:T 'RUN al encender'}" IsChecked="{Binding AutoRun}" VerticalAlignment="Center" Margin="0,0,14,4" />
                <CheckBox Content="{l:T 'Recargar solo'}" IsChecked="{Binding AutoReload}" VerticalAlignment="Center" Margin="0,0,0,4"
                          ToolTip="{l:T 'Cuando FactoryNodes deja un programa nuevo en la carpeta, se carga solo (como una descarga: se conservan los valores de lo que sigue igual)'}" />
            </WrapPanel>

            <!-- Variables y registro -->
            <TabControl Grid.Row="2" Background="White">
                <TabItem Header="{l:T 'Variables'}">
                    <DockPanel Margin="6">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VariablesText}" Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="{l:T 'Buscar una variable por su nombre (Motor1, Status.Run, io_)'}" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Variables}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Variable'}" Binding="{Binding Path, Mode=OneWay}" Width="3*" IsReadOnly="True" FontFamily="Consolas" />
                                <DataGridTextColumn Header="{l:T 'Tipo'}" Binding="{Binding Type, Mode=OneWay}" Width="80" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="{l:T 'Valor'}" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellBox}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                     ToolTip="{l:T 'Escribe un valor y pulsa Tab para ponerlo en el PLC (como forzar una entrada: el programa puede volver a escribirlo)'}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Problem, Mode=OneWay}" Width="2*" IsReadOnly="True" Foreground="{StaticResource RedBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{l:T 'Depurador'}" ToolTip="{l:T 'Paso a paso por el código de los bloques, de solo lectura. Los puntos de parada valen también en RUN.'}">
                    <Grid DataContext="{Binding Debug}" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Pausa'}" Command="{Binding PauseCommand}"
                                    ToolTip="{l:T 'Pausa: con la CPU en RUN, para en la primera sentencia del ciclo siguiente y la enseña aquí. «RUN» sigue.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.Pause}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Parar el ciclo'}" Command="{Binding StopCycleCommand}"
                                    ToolTip="{l:T 'Parar el ciclo: lo deja a medias sin terminarlo; la memoria queda como está.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.StopCycle}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Paso'}" Command="{Binding StepCommand}" Margin="10,0,6,0"
                                    ToolTip="{l:T 'Paso: ejecuta la sentencia marcada (una llamada a un bloque, entera) y para en la siguiente. Sin ciclo a medias, empieza uno.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.StepOver}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Entrar en el bloque de función'}" Command="{Binding StepIntoCommand}"
                                    ToolTip="{l:T 'Entrar en el bloque de función: ejecuta la sentencia marcada y, si llama a un bloque, para en su primera sentencia.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.StepInto}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Salir del bloque de función'}" Command="{Binding StepOutCommand}"
                                    ToolTip="{l:T 'Salir del bloque de función: ejecuta hasta volver al bloque que llamó a este y espera allí.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.StepOut}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Ciclo'}" Command="{Binding CycleCommand}"
                                    ToolTip="{l:T 'Ciclo: desde el puntero, termina este ciclo, empieza el siguiente y para al volver a la misma sentencia (si esa sentencia no se ejecuta, en la primera que se ejecute detrás).'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.Cycle}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Ejecutar hasta el cursor'}" Command="{Binding RunToCursorCommand}" Margin="10,0,6,0"
                                    ToolTip="{l:T 'Ejecutar hasta el cursor: ciclo tras ciclo hasta llegar a la línea del cursor, en la instancia elegida a la derecha.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.RunToCursor}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{l:T 'Punto de parada'}" Command="{Binding ToggleBreakpointCommand}"
                                    ToolTip="{l:T 'Poner o quitar un punto de parada en la línea del cursor (también con un clic en el margen de los números), en la instancia elegida a la derecha. Vale también con la CPU en RUN.'}">
                                <Image Width="18" Height="18" Source="{Binding Source={x:Static p:OpenIcons.Breakpoint}, Converter={StaticResource SvgImage}}" />
                            </Button>
                            <ComboBox ItemsSource="{Binding SectionChoices}" SelectedItem="{Binding SelectedSection}" Width="190" Margin="4,0,0,0" VerticalAlignment="Center"
                                      MaxDropDownHeight="520"
                                      ToolTip="{l:T 'Sección del programa, en el orden del ciclo y con su nombre en el PLC. Al final, los bloques de la librería.'}" />
                            <ComboBox ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding SelectedTarget}" Width="240" Margin="6,0,0,0" VerticalAlignment="Center"
                                      MaxDropDownHeight="520" IsEditable="True" IsTextSearchEnabled="True"
                                      ToolTip="{l:T 'Primero, la propia sección (su código en ST). Después, sus instancias por orden alfabético: los puntos de parada paran solo en la elegida. Escribe para buscar.'}" />
                        </WrapPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap" />
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasFault, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Content="{l:T 'Ver el fallo'}" Command="{Binding ShowFaultCommand}"
                                        ToolTip="{l:T 'La foto del momento del fallo: la línea en rojo, la pila de llamadas y los valores de entonces (la memoria de ahora puede ser otra).'}" />
                                <TextBlock Text="{Binding FaultText}" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <Border Grid.Row="2" Grid.Column="0" BorderBrush="{StaticResource MistBrush}" BorderThickness="1" Background="White">
                            <avalon:TextEditor x:Name="Editor" />
                        </Border>

                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding ShowingFault, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'Pila de llamadas del fallo'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding FaultFrames}" SelectedItem="{Binding SelectedFaultFrame}" DisplayMemberPath="Text" MaxHeight="120"
                                         BorderBrush="{StaticResource MistBrush}" ToolTip="{l:T 'El primero es el bloque donde falló; elige otro para ver su código y sus valores de entonces.'}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T 'Quitar todos'}" Padding="8,2" Command="{Binding RemoveAllBreakpointsCommand}" />
                                    <TextBlock Text="{l:T 'Puntos de parada'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding BreakpointRows}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Quitar este punto de parada'}" />
                                                <Ellipse Width="9" Height="9" Fill="Firebrick" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                                       ToolTip="{l:T 'Las variables del bloque donde está el puntero, con su valor: en dorado, las que cambió el último paso.'}">
                                <Run Text="{l:T 'Variables '}" /><Run Text="{Binding VariablesTitle, Mode=OneWay}" Foreground="{StaticResource GrayBrush}" FontWeight="Normal" />
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Variables}" BorderBrush="{StaticResource MistBrush}" Background="White"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{Binding Indent, Converter={StaticResource IndentMargin}}">
                                            <Button DockPanel.Dock="Left" Content="{Binding Glyph}" Command="{Binding ToggleCommand}" Width="16" Padding="0" Margin="0,0,2,0"
                                                    BorderThickness="0" Background="Transparent" Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="Consolas" Margin="8,0,0,0" ToolTip="{Binding Type}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource GoldTintBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{l:T 'Registro'}">
                    <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Margin="6" FontFamily="Consolas" FontSize="12"
                             ToolTip="{l:T 'Encendido, cargas, paros, fallos y los clientes que se conectan (también en registro.log de la carpeta de la instancia)'}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
